<settings>
  <servers>
    <server>
      <id>nexus</id>
      <username>admin</username>
      <password>Admin12345!</password>
    </server>
  </servers>
  <mirrors>
    <!-- Этот блок отключает блокировку HTTP для внутренних нужд TeamCity -->
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:http:*</mirrorOf>
      <name>Override default http blocker</name>
      <url>http://0.0.0.0/</url>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
</settings>